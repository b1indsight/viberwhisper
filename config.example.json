{
  "schema_version": 2,
  "input": {
    "hold_hotkey": "F8",
    "toggle_hotkey": "F9"
  },
  "audio": {
    "mic_gain": 3.0
  },
  "transcription": {
    "language": "zh",
    "prompt": "以下是一段简体中文的普通话句子，去掉首尾的语气词",
    "temperature": 0.0
  },
  "post_process": {
    "enabled": false,
    "preheat_enabled": true,
    "prompt": null,
    "temperature": 0.0
  },
  "inference": {
    "active": "api",
    "api": {
      "transcription": {
        "api_url": "https://api.groq.com/openai/v1/audio/transcriptions",
        "model": "whisper-large-v3-turbo"
      },
      "post_process": {
        "api_url": "https://api.openai.com/v1/chat/completions",
        "model": "gpt-4o-mini"
      }
    },
    "local": {
      "data_dir": "~/.viberwhisper",
      "server_port": 17265,
      "quantization": "int8"
    }
  }
}
