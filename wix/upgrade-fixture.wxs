<?xml version="1.0" encoding="UTF-8"?>
<!--
  Frozen 0.0.0 installer baseline used only by release CI to exercise major upgrades.
  Keep its UpgradeCode, component GUIDs, layout, and legacy marker unchanged after publication.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" RequiredVersion="7.0.0">
  <Package
    Name="ViberWhisper"
    Manufacturer="b1indsight"
    Version="0.0.0"
    UpgradeCode="F7DC481B-9922-476B-960F-B813EEC6B4E9"
    Scope="perMachine"
    InstallerVersion="500"
    Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of ViberWhisper is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Feature Id="Main" Title="ViberWhisper" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="LegacyMarker" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="ViberWhisper" />
    </StandardDirectory>

    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="AA05F0E0-9660-4AEB-8B09-42CF6356D601">
      <File Id="ViberWhisperExe" Source="$(var.ExePath)" Name="viberwhisper.exe" KeyPath="yes">
        <Shortcut
          Id="StartMenuShortcut"
          Directory="ProgramMenuFolder"
          Name="ViberWhisper"
          Description="Voice-to-text input tool"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="yes" />
      </File>
    </Component>

    <Component Id="LicenseFile" Directory="INSTALLFOLDER" Guid="E00D51FC-3B38-470F-B9AB-94CCF01B4826">
      <File Id="License" Source="LICENSE" KeyPath="yes" />
    </Component>

    <Component Id="LegacyMarker" Directory="INSTALLFOLDER" Guid="570A1AF0-40F5-4D75-9D65-2EAC569FE10E">
      <File Id="LegacyMarkerFile" Source="$(var.MarkerPath)" Name="legacy-fixture.txt" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
